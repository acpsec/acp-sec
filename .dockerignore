# ── Secrets — must never enter the build context ──────────────────────────
.env
.env.*
.env.local
.env.local.save
.env.save

# ── Git and CI ─────────────────────────────────────────────────────────────
.git
.github

# ── Python caches and build artifacts ─────────────────────────────────────
__pycache__
*.py[cod]
*$py.class
*.so
*.egg-info
*.egg
build/
dist/
.venv/
.venv.bak*/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Tests and dev-only requirements ───────────────────────────────────────
tests/
requirements/dev.txt

# ── Documentation and non-runtime project files ───────────────────────────
docs/
*.md
contracts/
scripts/
showcase/
openspec/
scans/
examples/
# Root-level reports/ (ad-hoc CLI output) — NOT data/reports/ (seeded scan results)
/reports/

# ── Runtime-generated state (gitignored; exclude defensively) ─────────────
data/scan_store.json
data/score_store.json
*.log
*.db
*.sqlite

# ── Editor and OS ─────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*~

# ── Tool and deploy configs (not needed inside container) ─────────────────
.railwayignore
railway.prod.json
railway.prod.nixpacks.bak
runtime.txt
.rtk/
.claude/
