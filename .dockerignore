# Unlike .gitignore, Docker anchors every pattern at the context ROOT: `.env`
# excludes ./.env but NOT ./acpsec_api/.env, and the Dockerfile's `COPY . .`
# would bake that nested file into the image. Patterns meant to apply at any
# depth therefore use `**/` (which also matches at the root).

# ── Secrets — must never enter the build context ──────────────────────────
**/.env
**/.env.*
**/*.pem
**/*.key
**/secrets/

# ── Git and CI ─────────────────────────────────────────────────────────────
.git
.github

# ── Python caches and build artifacts ─────────────────────────────────────
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.so
**/*.egg-info
**/*.egg
build/
dist/
.venv/
.venv.bak*/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# JS tooling for the ACP provider (acpsec/acp_provider/node_modules) — never runtime.
**/node_modules/

# ── Tests and dev-only requirements ───────────────────────────────────────
tests/
requirements/dev.txt

# ── Documentation and non-runtime project files ───────────────────────────
docs/
*.md
contracts/
scripts/
showcase/
openspec/
scans/
examples/
# Root-level reports/ (ad-hoc CLI output) — NOT data/reports/ (seeded scan results)
/reports/

# ── Runtime-generated state (gitignored; exclude defensively) ─────────────
data/scan_store.json
data/score_store.json
**/*.log
**/*.db
**/*.sqlite

# ── Editor and OS ─────────────────────────────────────────────────────────
**/.DS_Store
.vscode/
.idea/
**/*.swp
**/*~

# ── Tool and deploy configs (not needed inside container) ─────────────────
.railwayignore
railway.prod.json
railway.prod.nixpacks.bak
runtime.txt
.rtk/
.claude/
